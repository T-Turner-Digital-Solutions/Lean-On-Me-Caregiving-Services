# =============================================================================
# Lean On Me Caregiving Services — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a real `.env` file. NEVER expose the service-role key in the
# frontend. Only variables prefixed with VITE_ are bundled into client code.
# =============================================================================

# ---- Frontend (safe to expose — bundled into the client) --------------------
# Your Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# Supabase anon/public key. Protected by Row Level Security (RLS).
VITE_SUPABASE_ANON_KEY=
# Public site URL used for canonical/OG tags, e.g. https://leanonmecaregiving.org
VITE_SITE_URL=

# ---- Server-side only (Netlify Functions — NEVER expose to the browser) ------
# Supabase project URL (same value as above, used by serverless functions)
SUPABASE_URL=
# Supabase anon key (used by functions for RLS-protected inserts)
SUPABASE_ANON_KEY=
# Supabase SERVICE ROLE key — full DB access. Keep secret. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (transactional email — server-side only) ------------------------
RESEND_API_KEY=
# Verified "from" address in your Resend account, e.g. care@leanonmecaregiving.org
RESEND_FROM_EMAIL=
# Where new care-request notifications are delivered
ADMIN_NOTIFICATION_EMAIL=info@leanonmecargiving.org
